{
  "name": "car",
  "version": "1.0.0",
  "description": "CAR - Premium Automotive Platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:e2e": "node scripts/run-e2e.cjs",
    "test:e2e:install": "node scripts/install-e2e-browsers.cjs",
    "test:api:database": "node scripts/run-api-database-tests.cjs",
    "check:ui-baseline": "node scripts/verify-ui-baseline.cjs",
    "test:api": "npm run test --workspace=apps/api",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:functions": "node scripts/build-functions.js",
    "start": "npm run start --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "db:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=prisma/schema.prisma",
    "db:seed": "npx ts-node prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=prisma/schema.prisma",
    "deploy": "npm run build && npm run build:functions && firebase deploy"
  },
  "keywords": [
    "automotive",
    "car",
    "nextjs",
    "nestjs"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@neon/config": "^1.8.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "puppeteer": "^25.14.0"
  }
}
