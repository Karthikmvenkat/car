# CAR — Production Environment (Vercel + Render + Neon)
#
# SETUP INSTRUCTIONS:
# 1. Create a Neon database at https://neon.tech → copy the connection string
# 2. Deploy API to Render at https://render.com → copy the .onrender.com URL
# 3. Deploy frontend to Vercel at https://vercel.com
# 4. Fill in the values below and set them as environment variables

# ─── Database (Neon PostgreSQL) ────────────────────────────
# Get from: https://console.neon.tech → your project → Connection Details
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://neondb:YOUR_PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/car?sslmode=require"

# ─── API Server (Render) ───────────────────────────────────
PORT=4000
# Set this to your Render API URL (you'll get this after deploying)
FRONTEND_URL="https://your-app.vercel.app"

# ─── JWT ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-strong-random-secret-here"

# ─── Google OAuth (optional for demo) ──────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── Next.js (Vercel) ──────────────────────────────────────
# Set these as Environment Variables in Vercel dashboard
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_API_URL="https://car-api.onrender.com/api"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
