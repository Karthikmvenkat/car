# CAR Environment Configuration
# Copy this file to .env.local and fill in the values

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/car?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Authentication
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Image Storage (S3-compatible)
S3_BUCKET="car-images"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_CDN_URL=""

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@trycar.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"

# Admin
ADMIN_DEFAULT_EMAIL="admin@trycar.com"
ADMIN_DEFAULT_PASSWORD=""
